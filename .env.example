# コピーして .env を作成し、実値はGitへコミットしないでください。
DATABASE_URL=sqlite:///./.runtime/receipt_demo.db
SESSION_SECRET=portfolio-demo-session-secret-change-me-32-chars

# 初回マイグレーション時だけ管理者作成に使用します。
APP_USERNAME=demo
APP_EMAIL=demo@example.invalid
APP_PASSWORD=portfolio-demo-password-change-me

APP_ENV=development
# 公開用コピーではログイン画面を出さず、Mockデモへ直接入ります。
PORTFOLIO_DEMO_MODE=true
COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
LOGIN_FAILURE_LIMIT=5
LOGIN_RATE_LIMIT_MINUTES=10
INVITATION_VALID_HOURS=168
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_UPLOAD=5
MAX_IMAGE_PIXELS=25000000
MAX_REQUEST_BODY_BYTES=55000000
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_SECONDS=50
